# Safe defaults: simulated fills against Kalshi's demo market data.
TRADING_MODE=paper
KALSHI_ENV=demo
LIVE_TRADING_ENABLED=false
ALLOW_PRODUCTION=false

# Kalshi authenticated requests require BOTH the key ID and matching RSA key.
# The existing KALSHI_API_KEY name is accepted as a backward-compatible key ID.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Prefer a path. For secret managers only, a PEM string is also accepted:
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n..."

# Strict paper-replication forecasting. Forecasting and scheduling are explicit
# opt-ins so test processes and fresh databases cannot call the model by default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_REASONING_LEVEL=high
GEMINI_MAX_OUTPUT_TOKENS=2000
STRICT_PAPER_REPLICATION=true
FORECASTING_ENABLED=false
SCHEDULER_ENABLED=false
APP_ENV=production

# Paper methodology.
CYCLE_SECONDS=7200
MIN_DAYS_TO_CLOSE=2
MAX_DAYS_TO_CLOSE=14
STOP_HOURS_BEFORE_RESOLUTION=3
MAX_CLOSE_RESOLUTION_GAP_HOURS=1
REFRESH_MOVE_THRESHOLD=0.10
POSITION_SCALE_CONTRACTS=100
MIN_ACTIONABLE_EDGE=0.02
MAX_MARKETS_PER_CYCLE=8
MAX_FORECASTS_PER_CYCLE=4
DAILY_FORECAST_SPEND_LIMIT=1.00
FORECAST_RESERVE_COST_DOLLARS=0.15
FORECAST_PROMPT_VERSION=gemini-paper-v2
GEMINI_INPUT_COST_PER_MILLION=2.00
GEMINI_CACHED_INPUT_COST_PER_MILLION=0.20
GEMINI_OUTPUT_COST_PER_MILLION=12.00
GEMINI_SEARCH_COST_PER_QUERY=0.014

# Engineering guardrails added around the paper's otherwise unspecified risk budget.
PAPER_STARTING_CASH=200
MAX_TARGET_CONTRACTS=50
MAX_ORDER_CONTRACTS=25
MAX_MARKET_RISK_DOLLARS=25
MAX_TOTAL_EXPOSURE_DOLLARS=100
MAX_SPREAD=0.15
# Minimum displayed top-of-book dollars required on EACH entry direction. Kalshi's
# deprecated liquidity_dollars field is intentionally ignored because it returns zero.
MIN_LIQUIDITY_DOLLARS=1
MIN_EVIDENCE_SOURCES=1
BLOCK_HIGH_UNCERTAINTY=true

# Context watcher. Cron runs watch-once every minute; it refreshes price,
# lifecycle, and source state but never invokes the forecasting model.
EVENT_PRICE_MOVE_THRESHOLD=0.03
OFFICIAL_SOURCE_POLL_SECONDS=300
EVENT_TRIGGER_COOLDOWN_SECONDS=300
MAX_EVENT_TRIGGERS_PER_POLL=2
OFFICIAL_SOURCE_TIMEOUT_SECONDS=15
OFFICIAL_SOURCE_MAX_BYTES=1000000
OFFICIAL_SOURCE_ERROR_BACKOFF_SECONDS=21600

STATE_DB_PATH=state/trader.sqlite3
KILL_SWITCH_PATH=STOP
